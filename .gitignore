alembic/versions/*.pyc

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.env

# Docker
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Misc
*.pem
*.key
*.cert
.cache/
tmp/
